{
  "name": "apc-key25-visualizer",
  "version": "2.0.0",
  "description": "Electron + React front-end to drive and visualize the Akai APC Key 25 over Web MIDI.",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "start": "electron .",
    "lint": "echo \"add eslint if you want linting\""
  },
  "dependencies": {
    "electron": "^28.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0"
  }
}
